[Unit]
Description=牛来-作战台 盘中延后部署定时器（午休 12:30 + 收盘后 15:35）

[Timer]
# Wall times below are UTC (= Asia/Shanghai − 8h, no DST).
# Shanghai 12:30 → UTC 04:30 (morning backlog during lunch).
# Shanghai 15:35 → UTC 07:35 (afternoon backlog after close).
# Persistent=true so a missed fire still applies.
OnCalendar=Mon-Fri *-*-* 04:30:00
OnCalendar=Mon-Fri *-*-* 07:35:00
Persistent=true
Unit=market-desk-deferred-deploy.service

[Install]
WantedBy=timers.target
